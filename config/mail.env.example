# ============================================================
# send_email skill 邮箱配置模板（.env 格式）
# 使用方式：
#   1) 复制为同目录下的 mail.env 并填写；或
#   2) 运行 ../setup_mail.sh 交互式生成并测试
#
# 安全提示：mail.env 含邮箱授权码，已被 config/.gitignore 忽略，
#           切勿提交到公网仓库。也可不建文件，直接 export 下列变量。
# ============================================================

# 发件人邮箱（同时作为 SMTP 登录账号）
MAIL_FROM="your_name@example.com"

# 默认收件人，多个地址用英文逗号分隔
MAIL_TO="receiver@example.com"

# SMTP 服务器地址，例如：
#   腾讯企业邮 smtp.exmail.qq.com | QQ邮箱 smtp.qq.com
#   163邮箱 smtp.163.com        | Gmail  smtp.gmail.com
SMTP_HOST="smtp.example.com"

# SMTP 端口：587(STARTTLS) / 465(SSL) / 25(明文)
SMTP_PORT=587

# 邮箱授权码 / Token（不是登录密码）
SMTP_TOKEN="your_smtp_authorization_code"

# true = 启用加密。端口 465 走 SSL，其它端口走 STARTTLS
SMTP_SSL=true